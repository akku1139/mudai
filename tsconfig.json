{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "mudai/*": ["./src/*"]
    },

    // Module
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true, // Windows...

    // Emit
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": false,

    "allowJs": true,
    "checkJs": true,

    // Linting
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,

    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ]
}
